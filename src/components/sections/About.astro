---
import Profile from "../Profile.astro";
import { person } from "../../content/site";
---

<section id="about" aria-labelledby="about-heading">
  <header>
    <Profile headingId="about-heading" />
  </header>
  <div class="intro">
    <p>{person.description}</p>
    <p>
      I like things that feel simple. Thoughtful interfaces, readable code, and a web that works
      well for everyone.
    </p>
  </div>
</section>

<style>
  .intro {
    max-width: 36rem;
    margin-top: var(--profile-content-gap);
  }
  .intro p + p {
    margin-top: var(--space-4);
  }
</style>
