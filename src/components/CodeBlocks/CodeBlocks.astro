<div class="code-blocks">
  <slot />
</div>

<script>
  if (navigator.clipboard?.writeText) {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-code]").forEach((button) => {
      const block = button.closest(".code-block");
      const code = block?.querySelector("pre code");
      const status = block?.querySelector<HTMLElement>("[role='status']");
      if (!code || !status) return;

      button.hidden = false;
      const label = button.getAttribute("aria-label") ?? "Copy code";
      let resetTimer: ReturnType<typeof setTimeout>;

      button.addEventListener("click", async () => {
        clearTimeout(resetTimer);
        button.disabled = true;
        try {
          await navigator.clipboard.writeText(code.textContent ?? "");
          button.dataset.state = "copied";
          status.textContent = "Copied!";
          button.title = "Copied!";
        } catch {
          button.dataset.state = "error";
          status.textContent = "Couldn't copy. Select the code to copy it manually.";
          button.title = status.textContent;
        } finally {
          button.setAttribute("aria-label", status.textContent ?? label);
          button.disabled = false;
          resetTimer = setTimeout(() => {
            delete button.dataset.state;
            status.textContent = "";
            button.title = "Copy code";
            button.setAttribute("aria-label", label);
          }, 3000);
        }
      });
    });
  }
</script>

