---
import { essayDate, essayHref, readingMinutes, type Essay } from "../content/essays";
import MiniIllustration from "./ui/MiniIllustration.astro";
import SurfaceCard from "./ui/SurfaceCard.astro";

interface Props {
  essays: Essay[];
  headingLevel?: 2 | 3;
}

const { essays, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<ul class="essays" role="list">
  {essays.map((essay) => (
    <li>
      <SurfaceCard href={essayHref(essay)}>
        <div class="essay-content">
          <MiniIllustration name={essay.data.illustration} />
          <div>
            <Heading class="title">{essay.data.title}</Heading>
            <p class="description">{essay.data.description}</p>
            <p class="meta">
              <time datetime={essay.data.date.toISOString()}>{essayDate(essay.data.date)}</time>
              <span aria-hidden="true">·</span>
              <span>{readingMinutes(essay)} min read</span>
            </p>
          </div>
        </div>
      </SurfaceCard>
    </li>
  ))}
</ul>

<style>
  .essays {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .essay-content {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-4);
  }
  .title {
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .description {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-wrap: pretty;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
  @media (max-width: 400px) {
    .essay-content {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
