{
  "name": "konradbialy.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run check && astro build",
    "lint": "oxlint --deny-warnings .",
    "format": "node node_modules/oxfmt/bin/oxfmt --write .",
    "format:check": "node node_modules/oxfmt/bin/oxfmt --check .",
    "check": "astro sync && tsc --noEmit --runExternalCode"
  },
  "dependencies": {
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/ts-content-mapper": "0.2.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "7.1.0-beta",
    "wrangler": "^4.158.0"
  },
  "packageManager": "bun@1.4.4"
}
