---
import MiniIllustration from "../ui/MiniIllustration.astro";
import SurfaceCard from "../ui/SurfaceCard.astro";

const areas = [
  {
    illustration: "website",
    title: "Websites",
    description: "Fast, accessible websites with a clear purpose and a considered design.",
  },
  {
    illustration: "interface",
    title: "Interfaces",
    description: "Responsive layouts and interactions that make the everyday feel easy.",
  },
  {
    illustration: "product",
    title: "Digital products",
    description: "Turning an idea into working software, then making it better.",
  },
] as const;
---

<section aria-labelledby="what-heading" id="what-i-do">
  <h2 id="what-heading">What I do</h2>
  <ul class="areas" role="list">
    {areas.map(({ title, description, illustration }) => (
      <li>
        <SurfaceCard>
          <div class="area-content">
            <MiniIllustration name={illustration} />
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </div>
        </SurfaceCard>
      </li>
    ))}
  </ul>
</section>

<style>
  h2 {
    margin-bottom: var(--space-5);
  }
  .areas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .area-content {
    display: grid;
    gap: var(--space-5);
    font-size: var(--text-sm);
  }
  h3 {
    margin-bottom: var(--space-2);
    font-size: inherit;
    font-weight: 500;
    line-height: 1.5;
  }
  p {
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  @media (max-width: 600px) {
    .areas {
      grid-template-columns: 1fr;
    }
    .area-content {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: var(--space-4);
    }
    h3 {
      margin-bottom: var(--space-1);
    }
  }
</style>
