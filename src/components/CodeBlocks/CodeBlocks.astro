    border-radius: var(--radius-code) var(--radius-code) 0 0;
    background: var(--color-code-header-background);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.25;
  }
  .code-blocks :global(.code-block-file) {
    display: flex;
