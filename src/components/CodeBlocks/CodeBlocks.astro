    margin-inline-end: auto;
  }
  .code-blocks :global(.code-block-language) {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    width: var(--space-4);
    height: var(--space-4);
  }
  .code-blocks :global(.code-block-filename) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .code-blocks :global(.code-block-status) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .code-blocks :global(.code-block-copy) {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .code-blocks :global(.code-block-copy:not([hidden])) {
    display: inline-flex;
  }
  .code-blocks :global(.code-block-copy:hover) {
    background: var(--color-code-border);
  }
  .code-blocks :global(.code-block-copy:focus-visible) {
