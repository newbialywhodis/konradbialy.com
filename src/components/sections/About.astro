---
import { person } from "../../content/site";
import Signature from "../Signature.astro";
---

<section id="about" aria-labelledby="about-heading">
  <h1 id="about-heading">
    <span class="name">{person.name}</span>
    <Signature />
  </h1>
  <p class="subtitle">{person.role}</p>
  <div class="intro">
    <p>{person.description}</p>
    <p>
      I like things that feel simple. Thoughtful interfaces, readable code, and a web that works
      well for everyone.
    </p>
  </div>
</section>

<style>
  h1 {
    margin-bottom: var(--space-2);
  }
  .name {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .subtitle {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    font-weight: 550;
    line-height: 1.3;
  }
  .intro {
    max-width: 36rem;
    margin-top: var(--space-6);
  }
  .intro p:first-child {
    font-size: var(--text-lg);
    line-height: 1.7;
    letter-spacing: -0.02em;
  }
  .intro p + p {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }
</style>
