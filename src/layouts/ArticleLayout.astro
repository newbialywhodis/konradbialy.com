---
import type { MarkdownHeading } from "astro";
import WritingLayout from "./WritingLayout.astro";
import ArticleOutline from "../components/ArticleOutline.astro";
import CodeBlocks from "../components/CodeBlocks/CodeBlocks.astro";
import { essayDate, essayImageHref, readingMinutes, type Essay } from "../content/essays";
import { person } from "../content/site";

interface Props {
  essay: Essay;
  headings: MarkdownHeading[];
}

const { essay, headings } = Astro.props;
const { title, description, date } = essay.data;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  inLanguage: "en",
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  author: {
    "@type": "Person",
    name: person.name,
    url: new URL("/", Astro.site).href,
  },
};
---

<WritingLayout
  title={`${title} - ${person.name}`}
  description={description}
  publishedAt={date}
  socialImage={essayImageHref(essay)}
  socialImageAlt={title}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replace(/</gu, "\\u003c")}
  />
  <article aria-labelledby="article-title">
    <header>
      <p class="meta">
        <time datetime={date.toISOString()}>{essayDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(essay)} min read</span>
      </p>
      <h1 id="article-title">{title}</h1>
    </header>
    <ArticleOutline headings={headings} />
    <CodeBlocks>
      <div class="prose">
        <slot />
      </div>
    </CodeBlocks>
  </article>
</WritingLayout>

<style>
  article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  h1 {
    margin-top: var(--space-4);
    font-size: var(--text-article-title);
    font-weight: 550;
    line-height: 1.15;
    letter-spacing: -0.045em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .prose {
    font-size: var(--text-reading);
    line-height: var(--line-height-reading);
    overflow-wrap: anywhere;
  }
  .prose :global(> * + *) {
    margin-block-start: var(--space-5);
  }
  .prose :global(p),
  .prose :global(li) {
    text-wrap: pretty;
  }
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin-block: var(--space-7) var(--space-4);
    color: var(--color-text);
    font-weight: 550;
    line-height: 1.4;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }
  .prose :global(h2) {
    font-size: var(--text-article-heading);
  }
  .prose :global(h3),
  .prose :global(h4) {
    font-size: var(--text-reading);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }
  .prose :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: var(--space-5);
  }
  .prose :global(li + li) {
    margin-block-start: var(--space-2);
  }
  .prose :global(blockquote) {
    margin-inline: 0;
    padding-inline-start: var(--space-5);
    border-inline-start: 2px solid var(--color-border);
    color: var(--color-text-muted);
  }
  .prose :global(blockquote > * + *) {
    margin-block-start: var(--space-4);
  }
  .prose :global(:not(pre) > code) {
    font-family: var(--font-code);
    font-size: var(--text-code);
    padding: 0.1em 0.3em;
    border: 1px solid var(--color-code-border);
    border-radius: var(--radius-sm);
    background: var(--color-code-background);
    box-decoration-break: clone;
  }
  .prose :global(hr) {
    margin-block: var(--space-7);
    border: 0;
    border-top: 1px solid var(--color-border);
  }
  .prose :global(.article-sources) {
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: var(--line-height-sources);
  }
  .prose :global(.article-sources h3) {
    margin-block: 0 var(--space-3);
    font-size: inherit;
  }
  .prose :global(.article-sources ul) {
    margin-block: 0;
    padding-inline-start: var(--space-4);
  }
  .prose :global(.article-sources li + li) {
    margin-block-start: var(--space-1);
  }
  .prose :global(.article-sources a) {
    color: inherit;
  }
  .prose :global(.article-sources a:hover),
  .prose :global(.article-sources a:focus-visible) {
    color: var(--color-accent);
  }
  .prose :global(img),
  .prose :global(video) {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
