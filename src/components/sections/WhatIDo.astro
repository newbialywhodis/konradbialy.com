---
const areas = [
  {
    illustration: "website",
    title: "Websites",
    description: "Fast, accessible websites with a clear purpose and a considered design.",
  },
  {
    illustration: "interface",
    title: "Interfaces",
    description: "Responsive layouts and interactions that make the everyday feel easy.",
  },
  {
    illustration: "product",
    title: "Digital products",
    description: "Turning an idea into working software, then making it better.",
  },
];
---

<section aria-labelledby="what-heading" id="what-i-do">
  <h2 id="what-heading">What I do</h2>
  <ul class="areas" role="list">
    {areas.map(({ title, description, illustration }) => (
      <li class="area">
        <div class="illustration" aria-hidden="true">
          <svg width="48" height="40" viewBox="0 0 48 40" fill="none" focusable="false">
            {illustration === "website" && (
              <>
                <rect class="mini-surface" x="5.5" y="5.5" width="37" height="29" rx="3" />
                <path class="mini-outline" d="M6 12.5h36" />
                <path class="mini-detail" d="M10 9h1m3 0h1" />
                <rect class="mini-accent-soft" x="10" y="17" width="11" height="12" rx="1.5" />
                <path class="mini-ink" d="M26 19h10" />
                <path class="mini-detail" d="M26 23h7m-7 4h9" />
              </>
            )}
            {illustration === "interface" && (
              <>
                <rect class="mini-surface" x="8.5" y="3.5" width="31" height="33" rx="3" />
                <path class="mini-detail" d="M14 11h7m-7 10h5" />
                <rect class="mini-accent" x="27" y="8" width="8" height="5" rx="2.5" />
                <circle class="mini-knob" cx="32.5" cy="10.5" r="1.5" />
                <path class="mini-outline" d="M14 29.5h20" />
                <path class="mini-accent-line" d="M14 29.5h8" />
                <circle class="mini-control" cx="23" cy="29.5" r="2.5" />
                <rect class="mini-control" x="27.5" y="18.5" width="6" height="5" rx="1.5" />
              </>
            )}
            {illustration === "product" && (
              <>
                <rect class="mini-back" x="11.5" y="3.5" width="30" height="27" rx="3" />
                <rect class="mini-surface" x="6.5" y="9.5" width="30" height="27" rx="3" />
                <path class="mini-outline" d="M14.5 10v26" />
                <path class="mini-detail" d="M10.5 15v1m0 4v1m0 4v1" />
                <rect class="mini-accent-soft" x="19" y="15" width="12" height="8" rx="1.5" />
                <path class="mini-accent-line" d="m21.5 20 2.5-2 2 1 2.5-2" />
                <path class="mini-detail" d="M20 28h10m-10 4h6" />
              </>
            )}
          </svg>
        </div>
        <h3>{title}</h3>
        <p>{description}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  h2 {
    margin-bottom: var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .areas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .area {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }
  .illustration {
    display: grid;
    place-items: center;
    width: 72px;
    height: 54px;
    margin-bottom: var(--space-5);
    border-radius: var(--radius-sm);
    background: var(--color-illustration-background);
  }
  svg {
    overflow: visible;
  }
  .mini-surface {
    fill: var(--color-surface);
    stroke: var(--color-illustration-border);
    filter: drop-shadow(var(--shadow-illustration));
  }
  .mini-back {
    fill: var(--color-illustration-background);
    stroke: var(--color-illustration-border);
  }
  .mini-outline {
    stroke: var(--color-illustration-border);
  }
  .mini-detail,
  .mini-ink,
  .mini-accent-line {
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }
  .mini-detail {
    stroke: var(--color-illustration-detail);
  }
  .mini-ink {
    stroke: var(--color-text-muted);
  }
  .mini-accent-soft {
    fill: var(--color-accent-soft);
  }
  .mini-accent {
    fill: var(--color-accent);
  }
  .mini-accent-line {
    stroke: var(--color-accent);
    stroke-width: 1.5;
  }
  .mini-knob {
    fill: var(--color-surface);
  }
  .mini-control {
    fill: var(--color-surface);
    stroke: var(--color-illustration-detail);
  }
  h3 {
    margin-bottom: var(--space-2);
    font-size: inherit;
    font-weight: 500;
    line-height: 1.5;
  }
  p {
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  @media (max-width: 600px) {
    .areas {
      grid-template-columns: 1fr;
    }
    .area {
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      column-gap: var(--space-4);
    }
    .illustration {
      grid-row: span 2;
      margin-bottom: 0;
    }
    h3 {
      margin-bottom: var(--space-1);
    }
  }
</style>
