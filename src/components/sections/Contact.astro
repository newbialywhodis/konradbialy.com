---
import { person } from "../../content/site";
import ArrowUpRight from "../ui/ArrowUpRight.astro";
---

<section aria-labelledby="contact-heading" id="contact">
  <h2 id="contact-heading">Contact</h2>
  <p>
    Have something in mind, or just want to say hello?
    <br />
    I’d be happy to hear from you.
  </p>
  <div class="links">
    <a href={`mailto:${person.email}`}>
      {person.email}
      <span class="arrow">
        <ArrowUpRight />
      </span>
    </a>
    <a href={person.github} rel="me">
      GitHub
      <span class="arrow">
        <ArrowUpRight />
      </span>
    </a>
  </div>
</section>

<style>
  h2 {
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  p {
    color: var(--color-text-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-3);
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: var(--text-sm);
    text-decoration-color: var(--color-border);
    transition:
      color var(--duration-fast),
      text-decoration-color var(--duration-fast);
  }
  .arrow {
    display: flex;
    color: var(--color-text-muted);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  @media (hover: hover) {
    a:hover {
      color: var(--color-accent);
      text-decoration-color: currentColor;
    }
    a:hover .arrow {
      transform: translate(2px, -2px);
    }
  }
</style>
