---
import { localContext } from "../content/site";
---

<p class="local-status" data-local-status>
  <span data-clock hidden>
    <time></time>{" "}
  </span>
  in {localContext.country}
  <span data-weather hidden>
    {" · "}
    <a href="https://open-meteo.com/" title="Weather data by Open-Meteo">
      <span data-temperature></span>°C
    </a>
    . <span data-comment></span>
  </span>
</p>

<script>
  import { localContext } from "../content/site";

  const status = document.querySelector<HTMLElement>("[data-local-status]");
  const clock = status?.querySelector<HTMLElement>("[data-clock]");
  const time = clock?.querySelector("time");
  const weather = status?.querySelector<HTMLElement>("[data-weather]");
  const temperature = status?.querySelector<HTMLElement>("[data-temperature]");
  const comment = status?.querySelector<HTMLElement>("[data-comment]");

  if (clock && time && weather && temperature && comment) {
    const timeFormatter = new Intl.DateTimeFormat("en-GB", {
      timeZone: localContext.timeZone,
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
    });
    const refreshInterval = 15 * 60 * 1000;
    const maxAge = 30 * 60 * 1000;
    const cacheKey = `local-weather:${localContext.latitude},${localContext.longitude}`;
    type Reading = { temperature: number; observedAt: number };
    let reading: Reading | undefined;
    let pending = false;

    function isFresh(value: unknown): value is Reading {
      if (!value || typeof value !== "object") return false;
      if (!("temperature" in value) || !("observedAt" in value)) return false;
      return (
        typeof value.temperature === "number" &&
        Number.isFinite(value.temperature) &&
        typeof value.observedAt === "number" &&
        Number.isFinite(value.observedAt) &&
        Date.now() - value.observedAt >= 0 &&
        Date.now() - value.observedAt < maxAge
      );
    }

    function updateClock() {
      if (!clock || !time) return;
      const now = new Date();
      time.textContent = timeFormatter.format(now);
      time.dateTime = now.toISOString();
      clock.hidden = false;
    }

    function renderWeather() {
      if (!weather || !temperature || !comment) return;
      weather.hidden = !isFresh(reading);
      if (weather.hidden || !reading) return;
      const degrees = Math.round(reading.temperature);
      temperature.textContent = String(degrees);
      comment.textContent =
        degrees < 5
          ? "Going outside seems optional."
          : degrees < 16
            ? "Probably wearing a hoodie."
            : degrees < 26
              ? "The window is finally open."
              : "Working on staying cool.";
    }

    async function updateWeather() {
      renderWeather();
      if (pending || document.hidden) return;
      if (isFresh(reading) && Date.now() - reading.observedAt < refreshInterval) return;
      pending = true;
      try {
        const url = new URL("https://api.open-meteo.com/v1/forecast");
        url.search = new URLSearchParams({
          latitude: String(localContext.latitude),
          longitude: String(localContext.longitude),
          current: "temperature_2m",
          temperature_unit: "celsius",
          timeformat: "unixtime",
          forecast_days: "1",
        }).toString();
        const response = await fetch(url, {
          signal: AbortSignal.timeout(5000),
          credentials: "omit",
          referrerPolicy: "no-referrer",
        });
        if (!response.ok) return;
        const data = await response.json();
        const next: unknown = {
          temperature: data?.current?.temperature_2m,
          observedAt: data?.current?.time * 1000,
        };
        if (!isFresh(next)) return;
        reading = next;
        renderWeather();
        localStorage.setItem(cacheKey, JSON.stringify(reading));
      } catch {
        // Weather and browser storage are optional; the local clock still works.
      } finally {
        pending = false;
        renderWeather();
      }
    }

    try {
      const cached: unknown = JSON.parse(localStorage.getItem(cacheKey) ?? "null");
      if (isFresh(cached)) reading = cached;
    } catch {
      // Private browsing or a damaged cache should not prevent a fresh request.
    }

    updateClock();
    void updateWeather();
    window.setInterval(() => {
      if (document.hidden) return;
      updateClock();
      renderWeather();
    }, 60_000);
    window.setInterval(() => void updateWeather(), refreshInterval);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) return;
      updateClock();
      void updateWeather();
    });
  }
</script>

<style>
  .local-status {
    min-block-size: 2lh;
    text-align: end;
  }
  time {
    font-variant-numeric: tabular-nums;
  }
  a {
    text-decoration-color: var(--color-border);
  }
  a:hover {
    text-decoration-color: currentColor;
  }
</style>
